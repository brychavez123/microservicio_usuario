            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://100.27.17.133/api/usuarios/login",
          "protocol": "http",
          "host": [
            "100",
            "27",
            "17",
            "133"
          ],
          "path": [
            "api",
            "usuarios",
            "login"
          ]
        },
        "description": "Inicio de sesión. Público. Devuelve los datos del usuario y su rol.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@foro.cl\",\n  \"password\": \"Admin123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
